# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Group Chat ID (Starts with a minus '-', e.g., -5595004176 or -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=-PASTE_YOUR_GROUP_CHAT_ID_HERE
# Optional alias:
# TELEGRAM_GROUP_CHAT_ID=-100xxxxxxxxxx

PORT=3000
TZ=Asia/Kolkata

# --- Vercel deployment only ---
# Your Vercel deployment URL (no trailing slash), e.g. https://your-project.vercel.app
WEBHOOK_URL=https://your-project.vercel.app

# Optional: protects /api/cron/* from unauthorized access (set same value in Vercel env vars)
CRON_SECRET=PASTE_A_RANDOM_SECRET_HERE

