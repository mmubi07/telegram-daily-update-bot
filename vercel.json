{
  "version": 2,
  "builds": [
    {
      "src": "telegram-daily-update-bot/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "telegram-daily-update-bot/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/eod",
      "schedule": "30 11 * * *"
    }
  ]
}
